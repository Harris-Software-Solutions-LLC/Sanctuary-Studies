{
  "name": "sanctuary-studies",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Sanctuary Studies application",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node scripts/validate.cjs",
    "test:shared": "node scripts/test-shared-model.cjs",
    "test:store": "node scripts/test-store-persistence.cjs",
    "test:timeline": "node scripts/test-timeline-content.cjs",
    "test:scripture": "node scripts/test-scripture-content.cjs",
    "test:library": "node scripts/test-library-content.cjs",
    "test:symbolism-colors": "node scripts/test-symbolism-colors-content.cjs",
    "test:electron": "electron scripts/test-electron-root-workspace.cjs",
    "test:electron:library": "electron scripts/test-electron-library.cjs",
    "test:electron:scripture": "electron scripts/test-electron-scripture.cjs",
    "test:electron:library-content": "electron scripts/test-electron-library-content.cjs",
    "test:electron:symbolism-colors": "electron scripts/test-electron-symbolism-colors.cjs",
    "test:electron:study-lifecycle": "electron scripts/test-electron-study-lifecycle.cjs",
    "test:sanctuary-learning-explorer": "node scripts/test-sanctuary-learning-explorer-content.cjs",
    "test:learning-games": "node scripts/test-learning-games-content.cjs",
    "test:electron:sanctuary-learning-explorer": "electron scripts/test-electron-sanctuary-learning-explorer.cjs",
    "test:electron:learning-games": "electron scripts/test-electron-learning-games.cjs",
    "lint": "node scripts/validate.cjs --lint",
    "typecheck": "node scripts/validate.cjs --typecheck",
    "start:electron": "electron electron/main.cjs",
    "package:external": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-external.ps1"
  },
  "devDependencies": {
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
